# ── TK ONE backend AI proxy ───────────────────────────────────────────────
# The Anthropic API key lives ONLY on the server. It is never shipped to the
# browser. The frontend calls /api/analyze and the proxy adds this header.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model used by the proxy. Default is the most capable model.
# For high-volume / lower-cost analysis you can set: claude-sonnet-4-6
TKONE_MODEL=claude-opus-4-8

# Port the proxy listens on (vite dev proxies /api here).
PORT=8787
